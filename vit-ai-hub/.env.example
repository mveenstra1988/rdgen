# Kopieer naar ~/.config/vit/geheimen/ai-gateway.env of vit-ai-hub/.env
# Nooit committen met echte keys.

VIT_GATEWAY_HOST=127.0.0.1
VIT_GATEWAY_PORT=8787
VIT_GATEWAY_TOKEN=change-me-local-token

# Lokaal
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Subscription bridge (Claude Code + Codex OAuth via bijv. CLIProxyAPI)
BRIDGE_BASE_URL=http://127.0.0.1:8317/v1
BRIDGE_API_KEY=

# OpenRouter (gratis + betaalde modellen, o.a. DeepSeek free)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek (direct, optioneel — anders via OpenRouter)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OmniRoute
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=

# Cursor custom provider (zelfde gateway of bridge)
CURSOR_BASE_URL=
CURSOR_API_KEY=

# Grok / xAI
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1

# Privacy
VIT_PII_MODE=fail_closed
VIT_PII_CLOUD_ACTION=block
VIT_AUDIT_LOG=./data/audit.jsonl

# Auto routing
VIT_DEFAULT_MODEL=vit/auto
VIT_LOCAL_LIGHT_MODEL=
VIT_LOCAL_HEAVY_MODEL=

# Projectmappen voor software/webdesign tools (colon-gescheiden)
# VIT_WORKSPACE_ROOTS=/Users/jij/Projects:/Users/jij/Developer