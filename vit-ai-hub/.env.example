# Kopieer naar ~/.config/vit/geheimen/ai-gateway.env of vit-ai-hub/.env
# Nooit committen met echte keys.

VIT_GATEWAY_HOST=127.0.0.1
VIT_GATEWAY_PORT=8787
VIT_GATEWAY_TOKEN=change-me-local-token
# iPhone / LAN: zet VIT_GATEWAY_HOST=0.0.0.0 en VIT_LAN_ACCESS=1 (via GUI Instellingen)
# VIT_LAN_ACCESS=0

# Lokaal
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Subscription bridge (Claude Code + Codex OAuth via bijv. CLIProxyAPI)
BRIDGE_BASE_URL=http://127.0.0.1:8317/v1
BRIDGE_API_KEY=

# OpenRouter (gratis + betaalde modellen, o.a. DeepSeek free)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek (direct, optioneel — anders via OpenRouter)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OmniRoute
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=

# Cursor custom provider (zelfde gateway of bridge)
CURSOR_BASE_URL=
CURSOR_API_KEY=

# Grok / xAI
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1

# Privacy
VIT_PII_MODE=fail_closed
VIT_PII_CLOUD_ACTION=block
VIT_AUDIT_LOG=./data/audit.jsonl

# Auto routing
VIT_DEFAULT_MODEL=vit/auto
VIT_LOCAL_LIGHT_MODEL=
VIT_LOCAL_HEAVY_MODEL=

# Projectmappen voor software/webdesign tools (colon-gescheiden)
# VIT_WORKSPACE_ROOTS=/Users/jij/Projects:/Users/jij/Developer

# Ops / infra (aparte file, chmod 600):
# ~/.config/vit/geheimen/ops.env
# Zie template die de hub aanmaakt (PVE_HOSTS, MAILCOW_*, NEXTCLOUD_*, UNIFI_*, …).
# VPN nodig voor Proxmox/UniFi. Tools zijn read-first; VM-mutaties eisen confirm=true.

# Multi-abo pools (aanbevolen: GUI of accounts.json)
# ~/.config/vit/geheimen/accounts.json
# Of genummerd in env (bridge/cursor/openrouter/…):
# BRIDGE_BASE_URL_1=http://127.0.0.1:8317/v1
# BRIDGE_API_KEY_1=
# BRIDGE_BASE_URL_2=http://127.0.0.1:8318/v1
# BRIDGE_API_KEY_2=
# CURSOR_BASE_URL_1=...
# Bij 429/quota: cooldown → volgende abo automatisch.