#!/bin/bash
# Launcher inside .app — resolves hub root next to the app or installed location.
set -euo pipefail

# Contents/MacOS -> Contents -> .app
APP_BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"
PARENT="$(cd "$APP_BUNDLE/.." && pwd)"
# Prefer hub nested in the .app, then sibling hub from the zip, then install paths
CANDIDATES=(
  "$APP_BUNDLE/hub"
  "$PARENT/hub"
  "$HOME/Applications/VIT-AI-Hub/hub"
  "$HOME/VIT-AI-Hub"
  "/Applications/VIT-AI-Hub/hub"
)

ROOT=""
for c in "${CANDIDATES[@]}"; do
  if [[ -f "$c/scripts/one-shot-setup.sh" ]]; then
    ROOT="$(cd "$c" && pwd)"
    break
  fi
done

if [[ -z "$ROOT" ]]; then
  osascript -e 'display dialog "VIT AI Hub bestanden niet gevonden.\nHoud de map hub bij deze app (zip-inhoud), of installeer naar /Applications/VIT-AI-Hub/hub" buttons {"OK"} default button 1' || true
  exit 1
fi

# Clear quarantine so double-click works after download
xattr -dr com.apple.quarantine "$APP_BUNDLE" 2>/dev/null || true
xattr -dr com.apple.quarantine "$ROOT" 2>/dev/null || true

# If already healthy, just open UI (wizard only on first setup)
if curl -sf "http://127.0.0.1:8787/health" >/dev/null 2>&1; then
  if [[ -f "$ROOT/data/.setup-complete" ]]; then
    open "http://127.0.0.1:8787/"
  else
    open "http://127.0.0.1:8787/?wizard=1"
  fi
  exit 0
fi

osascript -e 'display notification "VIT AI Hub wordt gestart…" with title "VIT AI Hub"' || true
bash "$ROOT/scripts/one-shot-setup.sh"
