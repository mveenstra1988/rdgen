#!/bin/bash
# VIT AI Hub.app — start alles bij openen, stop bij sluiten (één app).
set -euo pipefail

APP_BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"
PARENT="$(cd "$APP_BUNDLE/.." && pwd)"
CANDIDATES=(
  "$APP_BUNDLE/hub"
  "$PARENT/hub"
  "$HOME/Applications/VIT-AI-Hub/hub"
  "$HOME/VIT-AI-Hub"
  "/Applications/VIT-AI-Hub/hub"
)

ROOT=""
for c in "${CANDIDATES[@]}"; do
  if [[ -f "$c/scripts/app-session.sh" ]] || [[ -f "$c/scripts/one-shot-setup.sh" ]]; then
    ROOT="$(cd "$c" && pwd)"
    break
  fi
done

if [[ -z "$ROOT" ]]; then
  osascript -e 'display dialog "VIT AI Hub bestanden niet gevonden.\nHoud de map hub in de app (DMG/zip-inhoud)." buttons {"OK"} default button 1' || true
  exit 1
fi

xattr -dr com.apple.quarantine "$APP_BUNDLE" 2>/dev/null || true
xattr -dr com.apple.quarantine "$ROOT" 2>/dev/null || true

# Voorkom dubbele sessies
if [[ -f "$ROOT/data/run/session.pid" ]]; then
  OLD="$(cat "$ROOT/data/run/session.pid" 2>/dev/null || true)"
  if [[ -n "$OLD" ]] && kill -0 "$OLD" 2>/dev/null; then
    if curl -sf "http://127.0.0.1:8787/health" >/dev/null 2>&1; then
      open "http://127.0.0.1:8787/"
      # Blijf wachten tot bestaande sessie stopt (of gebruiker quits deze instance)
      while kill -0 "$OLD" 2>/dev/null; do sleep 2; done
      exit 0
    fi
  fi
fi

exec bash "$ROOT/scripts/app-session.sh"
